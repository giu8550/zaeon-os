# Caddy — proxy reverso + HTTPS automático (Let's Encrypt) da beta Zaeon.
# Domínio e e-mail vêm do .env (BETA_DOMAIN / ACME_EMAIL). O reverse_proxy já
# faz upgrade de WebSocket sozinho — o Socket.IO do server.js funciona sem config extra.

{
	email {$ACME_EMAIL}
	# Para testar sem domínio/TLS válido, descomente a linha abaixo (HTTP local):
	# auto_https off
}

{$BETA_DOMAIN} {
	encode zstd gzip

	# Health check direto no proxy (não precisa subir até o app).
	respond /healthz "ok" 200

	reverse_proxy web:3000 {
		# Repassa os headers reais pro Next/NextAuth atrás do proxy.
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up X-Real-IP {remote_host}
	}
}

# ── Host de preview PERMANENTE via sslip.io ──────────────────────────────────
# sslip.io resolve 75-119-140-97.sslip.io -> 75.119.140.97 sozinho (sem DNS nosso),
# então o Caddy emite HTTPS Let's Encrypt válido. Fica NO GIT de propósito: assim
# sobrevive a `git reset --hard` do deploy e a gente confere cada mudança em prod.
# Remover quando beta.zaeon.space apontar pra cá (ou manter como staging interno).
75-119-140-97.sslip.io {
	encode zstd gzip
	respond /healthz "ok" 200
	reverse_proxy web:3000
}
