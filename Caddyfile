# Caddy — proxy reverso + HTTPS automático (Let's Encrypt) da beta Zaeon.
# Domínio e e-mail vêm do ambiente (BETA_DOMAIN / ACME_EMAIL — o deploy.yml manda).
# BETA_DOMAIN aceita VÁRIOS hostnames separados por vírgula: o endereço provisório
# (sslip.io) e o definitivo (zaeon.com.br) convivem, cada um com seu certificado.
# Se um deles ainda não resolve no DNS, o Caddy só falha o ACME DELE e segue servindo
# os outros — por isso dá pra apontar o domínio novo antes de virar a chave.
# O reverse_proxy já faz upgrade de WebSocket sozinho — o Socket.IO do server.js
# funciona sem config extra.

{
	email {$ACME_EMAIL}
	# Para testar sem domínio/TLS válido, descomente a linha abaixo (HTTP local):
	# auto_https off
}

{$BETA_DOMAIN} {
	encode zstd gzip

	# Health check direto no proxy (não precisa subir até o app). Num `handle` próprio: com o `handle {}` de baixo
	# (catch-all), um `respond` solto perderia a vez (na ordem do Caddy, handle vem antes de respond).
	handle /healthz {
		respond "ok" 200
	}

	# Realtime do cyberespaço (Colyseus): matchmaking HTTP + WebSocket. handle_path tira o "/colyseus".
	# Se o serviço não estiver de pé, só esta rota dá 502 (o resto do site segue normal).
	handle_path /colyseus/* {
		reverse_proxy colyseus:2567
	}

	handle {
		reverse_proxy web:3000 {
			# Repassa os headers reais pro Next/NextAuth atrás do proxy.
			header_up X-Forwarded-Proto {scheme}
			header_up X-Forwarded-Host {host}
			header_up X-Real-IP {remote_host}
		}
	}
}

# ── Host de preview PERMANENTE via sslip.io ──────────────────────────────────
# sslip.io resolve 75-119-140-97.sslip.io -> 75.119.140.97 sozinho (sem DNS nosso),
# então o Caddy emite HTTPS Let's Encrypt válido. Fica NO GIT de propósito: assim
# sobrevive a `git reset --hard` do deploy e a gente confere cada mudança em prod.
# Remover quando o domínio definitivo apontar pra cá (ou manter como staging interno).
75-119-140-97.sslip.io {
	encode zstd gzip
	handle /healthz {
		respond "ok" 200
	}
	handle_path /colyseus/* {
		reverse_proxy colyseus:2567
	}
	handle {
		reverse_proxy web:3000
	}
}

# ── www → raiz ────────────────────────────────────────────────
# O client OAuth do Google NÃO aceita o callback com www: quem entrasse pelo www
# levaria redirect_uri_mismatch no login. Em vez de cadastrar um segundo callback,
# o www nunca chega a ser endereço de app — redireciona 301 pra raiz antes de
# qualquer rota.
www.zaeon.com.br {
	redir https://zaeon.com.br{uri} permanent
}
