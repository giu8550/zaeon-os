# Copie para .env (ao lado do compose) e preencha. NUNCA commitar o .env real.

# IP do TAILSCALE desta box onde o LiteLLM escuta (`tailscale ip -4` → 100.x.y.z).
# As interfaces/CLIs da Zaeon conectam neste IP:4000. NUNCA use 0.0.0.0, e NUNCA
# 10.99.0.2 (WireGuard da chipflow — a Zaeon não entra nessa rede).
BIND_ADDR=127.0.0.1

# Chave mestra do gateway (gere uma forte, ex.: `openssl rand -hex 24`).
LITELLM_MASTER_KEY=troque-esta-chave
# Salt das virtual keys no banco (`openssl rand -hex 24`). Gerar 1x; trocar = perder as keys.
LITELLM_SALT_KEY=troque-este-salt

# Postgres/pgvector da Zaeon (RAG + virtual keys do LiteLLM).
ZAEON_PG_USER=zaeon
ZAEON_PG_PASSWORD=troque-esta-senha
ZAEON_PG_DB=zaeon_rag
