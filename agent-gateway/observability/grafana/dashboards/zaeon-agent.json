{
  "annotations": { "list": [] },
  "editable": true,
  "schemaVersion": 39,
  "title": "Zaeon Agent — Overview",
  "tags": ["zaeon", "agent"],
  "time": { "from": "now-6h", "to": "now" },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Inbound por tipo (msg/s)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "targets": [
        { "expr": "rate(zaeon_agent_inbound_total[5m])", "legendFormat": "{{kind}}" }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Dedup skips (msg/s)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "rate(zaeon_agent_dedup_skips_total[5m])", "legendFormat": "dedup" }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "agent-api up",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 8 },
      "targets": [ { "expr": "up{job=\"zaeon_agent_api\"}" } ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Inbound total (24h)",
      "datasource": { "type": "prometheus", "uid": "${DS_PROMETHEUS}" },
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 8 },
      "targets": [ { "expr": "sum(increase(zaeon_agent_inbound_total[24h]))" } ]
    }
  ]
}
